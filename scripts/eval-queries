#!/usr/bin/env python3
"""Evaluate agentic-coding retrieval queries against an installed Pack by looping the
lore CLI (query / pack list / index status / index build / index operation).

This is a repository-side evaluation harness, not a Lorelum validator and not a Pack
resource. It changes no CLI behavior and proves observed selection only; it does not
prove content quality or downstream Agent behavior.

Usage:
    python scripts/eval-queries --mode keyword --ensure-install agentic-coding@0.4.0 \
        --store-root tmp/eval-store --out run.json --report run.md
    python scripts/eval-queries --mode both --baseline fixtures/agentic-coding/baselines/...json

Requires Python 3.9+ and PyYAML.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import json
import os
import re
import shutil
import sys
import time
from collections import defaultdict

try:
    import yaml
except ImportError:  # pragma: no cover
    print("error: PyYAML is required (pip install pyyaml)", file=sys.stderr)
    sys.exit(1)

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
if SCRIPT_DIR not in sys.path:
    sys.path.insert(0, SCRIPT_DIR)

from eval_queries_baseline import baseline_compatibility_errors, compare_baseline
from eval_queries_candidate import project_pack_details
from eval_queries_gates import GateFailure, limit_conflicts_with_formal_gates, resolve_run_policy
from eval_queries_lore import run_lore as _run_lore_impl

SCHEMA = "eval-queries-run/1"
RUNNING_STATES = {"preparing", "running", "building", "pending"}
REPORT_NOTE = (
    "Evaluation-only evidence: observed retrieval selection for the fixture queries on one "
    "machine and one Pack revision. It is not a claim about content quality, other queries, "
    "other modes that were unavailable, or downstream Agent behavior."
)
ACTIVE_QUERY_STATUSES = {"candidate", "reviewed", "frozen"}
QUERY_STATUSES = ACTIVE_QUERY_STATUSES | {"retired"}
QUERY_MIGRATION_KINDS = {"reassign", "merge", "replace", "retire"}
PRACTICE_MIGRATION_KINDS = {"merge", "replace", "retire", "refine"}


def run_lore(lore, args, store_root, timeout, project_root=None):
    # Test and orchestration boundary: candidate loading can be patched independently.
    return _run_lore_impl(lore, args, store_root, timeout, project_root)


def _now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).replace(microsecond=0).isoformat()



def load_fixtures(path: str) -> dict:
    with open(path, encoding="utf-8") as fh:
        doc = yaml.safe_load(fh)
    if not isinstance(doc, dict) or not isinstance(doc.get("queries"), list):
        raise ValueError(f"{path}: expected a top-level 'queries' list")
    ids, texts = set(), set()
    for q in doc["queries"]:
        for field in ("id", "kind", "expect", "text"):
            if not q.get(field):
                raise ValueError(f"{path}: query entry missing '{field}': {q}")
        if q["kind"] not in ("positive", "neighbor"):
            raise ValueError(f"{path}: kind must be positive|neighbor, got {q['kind']} ({q['id']})")
        if q["kind"] == "neighbor" and not q.get("resembles"):
            raise ValueError(f"{path}: neighbor query missing 'resembles' ({q['id']})")
        status = q.get("status", "frozen")
        if status not in QUERY_STATUSES:
            raise ValueError(f"{path}: invalid query status {status!r} ({q['id']})")
        if status == "retired" and (not isinstance(q.get("retired_reason"), str) or not q["retired_reason"].strip()):
            raise ValueError(f"{path}: retired query missing 'retired_reason' ({q['id']})")
        if q.get("previous_expect"):
            if q["previous_expect"] == q["expect"]:
                raise ValueError(f"{path}: previous_expect must differ from expect ({q['id']})")
            if q.get("migration_kind") not in QUERY_MIGRATION_KINDS:
                raise ValueError(f"{path}: migrated query needs migration_kind ({q['id']})")
            if not q.get("migration_reason"):
                raise ValueError(f"{path}: migrated query needs migration_reason ({q['id']})")
        if q.get("migration_kind") and q["migration_kind"] not in QUERY_MIGRATION_KINDS:
            raise ValueError(f"{path}: invalid migration_kind {q['migration_kind']!r} ({q['id']})")
        if "acceptable" in q or q.get("acceptance") == "multi-valid":
            raise ValueError(f"{path}: multi-valid Query expectations are not supported ({q['id']})")
        replacements = q.get("replacement_queries")
        if replacements is not None and (
            not isinstance(replacements, list) or not replacements
            or any(not isinstance(item, str) or not item for item in replacements)
            or len(replacements) != len(set(replacements))
        ):
            raise ValueError(f"{path}: replacement_queries must be a non-empty list of unique Query IDs ({q['id']})")
        if q["id"] in ids:
            raise ValueError(f"{path}: duplicate query id {q['id']}")
        if q["text"].strip().lower() in texts:
            raise ValueError(f"{path}: duplicate query text ({q['id']})")
        ids.add(q["id"])
        texts.add(q["text"].strip().lower())
    migrations = doc.get("practice_migrations", [])
    if not isinstance(migrations, list):
        raise ValueError(f"{path}: practice_migrations must be a list")
    queries_by_id = {q["id"]: q for q in doc["queries"]}
    for migration in migrations:
        for field in ("old_practice", "kind", "reason"):
            if not migration.get(field):
                raise ValueError(f"{path}: practice migration missing '{field}': {migration}")
        if migration["kind"] not in PRACTICE_MIGRATION_KINDS:
            raise ValueError(f"{path}: invalid practice migration kind {migration['kind']!r}")
        if migration["kind"] != "retire" and not migration.get("new_practice"):
            raise ValueError(f"{path}: non-retirement migration missing 'new_practice': {migration}")
        query_ids = migration.get("query_ids")
        if not isinstance(query_ids, list) or not query_ids:
            raise ValueError(f"{path}: practice migration needs non-empty query_ids: {migration}")
        if any(not isinstance(qid, str) or not qid for qid in query_ids) or len(query_ids) != len(set(query_ids)):
            raise ValueError(f"{path}: practice migration query_ids must be unique Query IDs: {migration}")
        missing = [qid for qid in query_ids if qid not in queries_by_id]
        if missing:
            raise ValueError(f"{path}: practice migration references unknown Query IDs: {', '.join(missing)}")
        for qid in query_ids:
            query = queries_by_id[qid]
            old = migration["old_practice"]
            new = migration.get("new_practice")
            is_retired = query.get("status", "frozen") == "retired"
            if query.get("previous_expect") != old and (not is_retired or query.get("expect") != old):
                raise ValueError(
                    f"{path}: migration Query {qid} must belong to old Practice {old}"
                )
            if new and is_retired and query.get("expect") not in (old, new):
                raise ValueError(f"{path}: retired migration Query {qid} has unrelated expect")
            if new and not is_retired and query.get("expect") != new:
                raise ValueError(
                    f"{path}: migration Query {qid} expect must be {new} or be retired"
                )
            if migration["kind"] == "retire" and not is_retired:
                raise ValueError(f"{path}: retire migration Query {qid} must have status: retired")
    return doc


def ensure_installed(lore: str, spec: str, store_root: str | None) -> None:
    name, _, want_version = spec.partition("@")
    listed = run_lore(lore, ["pack", "list"], store_root, 120)
    if listed["ok"]:
        for pack in listed["data"].get("packs", []):
            if pack.get("name") == name and (not want_version or pack.get("version") == want_version):
                return
    print(f"install: {spec}" + (f" into {store_root}" if store_root else ""))
    res = run_lore(lore, ["pack", "install", spec], store_root, 600)
    if not res["ok"]:
        err = res.get("error") or {}
        raise SystemExit(f"error: lore pack install {spec} failed: {err.get('code')}: {err.get('message')}")


def installed_pack_details(lore: str, name: str, store_root: str | None) -> dict:
    res = run_lore(lore, ["pack", "list", name], store_root, 120)
    if not res["ok"]:
        err = res.get("error") or {}
        raise SystemExit(f"error: lore pack list {name} failed: {err.get('code')}: {err.get('message')}")
    data = res["data"]
    return {
        "name": data["pack"]["name"],
        "version": data["pack"]["version"],
        "practice_ids": sorted(p["id"] for p in data.get("practices", [])),
        "practices": [
            {"id": p["id"], "title": p.get("title", ""), "applies_when": p.get("applies_when", "")}
            for p in data.get("practices", [])
        ],
    }



DISCIPLINE_STOPWORDS = set(
    "a an the of to in on for and or is are was were be been it its this that with without must not no "
    "do does can could should would will shall may might as at by from into than then there their they "
    "you your we our i me my when where which who whom what how before after during while".split()
)


def discipline_violations(queries: list, practices: list) -> list:
    """Flag queries sharing a 4+-word run with any installed Practice's title/applies_when.

    Such queries match the keyword index by quotation rather than meaning, so a hit proves
    nothing about retrieval; the shipped fixture is written to pass this check.
    """
    practice_grams = {}
    for p in practices:
        words = re.findall(r"[a-z]+", (p["title"] + " " + p["applies_when"]).lower())
        grams = set()
        for n in (5, 4):
            for i in range(len(words) - n + 1):
                g = tuple(words[i:i + n])
                if len([w for w in g if w not in DISCIPLINE_STOPWORDS]) >= max(2, n - 2):
                    grams.add(g)
        if grams:
            practice_grams[p["id"]] = grams
    out = []
    for q in queries:
        qw = re.findall(r"[a-z]+", q["text"].lower())
        qgrams = {tuple(qw[i:i + n]) for n in (5, 4) for i in range(len(qw) - n + 1)}
        for pid, grams in practice_grams.items():
            for g in grams & qgrams:
                out.append({"query": q["id"], "practice": pid, "n": len(g), "shared": " ".join(g)})
    return out


def partition_queries(queries: list, installed_ids: set) -> tuple[list, list]:
    """Split active queries into runnable and skipped (missing Practice targets)."""
    runnable, skipped = [], []
    for q in queries:
        targets = {q["expect"]} if q["kind"] == "positive" else {q["expect"], q["resembles"]}
        missing = sorted(targets - installed_ids)
        if missing:
            skipped.append({"id": q["id"], "reason": f"practice not installed: {', '.join(missing)}"})
        else:
            runnable.append(q)
    return runnable, skipped


def _active_queries(doc: dict) -> list:
    return [q for q in doc["queries"] if q.get("status", "frozen") != "retired"]


def _practice_migration_exists(
    doc: dict,
    old_practice: str,
    new_practice: str | None = None,
    query_id: str | None = None,
) -> bool:
    for migration in doc.get("practice_migrations", []):
        if migration.get("old_practice") != old_practice:
            continue
        if new_practice is not None and migration.get("new_practice") != new_practice:
            continue
        if query_id is not None and query_id not in migration.get("query_ids", []):
            continue
        return True
    return False


def validate_migration_coverage(doc: dict, installed_ids: set) -> list:
    """Validate explicit Query migrations and preserved coverage boundaries.

    A migrated Query no longer counts as coverage for ``previous_expect``. If the
    old Practice remains active, the fixture must provide an independent positive
    and an old-vs-new neighbor query. Retired/missing Practices instead require an
    explicit practice_migrations record or per-query migration metadata.
    """
    active = _active_queries(doc)
    positives = [q for q in active if q["kind"] == "positive"]
    failures = []
    checked_pairs = set()
    for q in doc["queries"]:
        previous = q.get("previous_expect")
        if not previous:
            continue
        current = q["expect"]
        if previous not in installed_ids:
            # Practice migrations list affected Query IDs, not just old/new pairs.
            if not _practice_migration_exists(doc, previous, current, q["id"]):
                failures.append({
                    "query": q["id"],
                    "old_practice": previous,
                    "new_practice": current,
                    "reason": "missing Practice migration record linked to this Query for inactive old Practice",
                })
            continue

        pair = (previous, current)
        if pair in checked_pairs:
            continue
        checked_pairs.add(pair)
        independent_old = any(
            p["expect"] == previous and not p.get("previous_expect")
            for p in positives
        )
        if not independent_old:
            failures.append({
                "query": q["id"],
                "old_practice": previous,
                "new_practice": current,
                "reason": "active old Practice has no independent positive query after migration",
            })
        boundary = any(
            n["kind"] == "neighbor"
            and n["expect"] == previous
            and n.get("resembles") == current
            for n in active
        )
        if not boundary:
            failures.append({
                "query": q["id"],
                "old_practice": previous,
                "new_practice": current,
                "reason": "active old Practice is missing an old-vs-new neighbor query",
            })
    active_ids = {q["id"] for q in active}
    for q in doc["queries"]:
        if q.get("status", "frozen") != "retired":
            continue
        replacements = q.get("replacement_queries", [])
        missing = [replacement for replacement in replacements if replacement not in active_ids]
        if missing:
            failures.append({
                "query": q["id"],
                "reason": f"retired Query references missing replacement_queries: {', '.join(missing)}",
            })
    return failures


def semantic_readiness(lore: str, store_root: str | None, timeout_s: int) -> dict:
    """Return {"state": "ready"|"degraded", ...}; never raises for index failures."""
    status = run_lore(lore, ["index", "status"], store_root, 120)
    if status["ok"]:
        state = str(status["data"].get("state", "")).lower()
        if state and state not in RUNNING_STATES and state != "missing":
            return {"state": "ready", "detail": f"index already built (status state: {state})"}
    build = run_lore(lore, ["index", "build"], store_root, 300)
    if not build["ok"]:
        err = build.get("error") or {}
        return {"state": "degraded", "code": err.get("code", "unknown"), "message": err.get("message", ""), "detail": "index build rejected"}
    data = build.get("data") or {}
    op_id = data.get("operationId") or data.get("preparationId")
    deadline = time.monotonic() + timeout_s
    poll_ended_ok = False
    while time.monotonic() < deadline:
        time.sleep(5)
        if not op_id:
            poll_ended_ok = True
            break
        op = run_lore(lore, ["index", "operation", op_id], store_root, 120)
        if op["ok"]:
            state = str((op.get("data") or {}).get("state", "")).lower()
            if not state or state not in RUNNING_STATES:
                poll_ended_ok = True
                break
        else:
            err = op.get("error") or {}
            return {"state": "degraded", "code": err.get("code", "unknown"), "message": err.get("message", ""), "detail": f"index operation {op_id} failed"}
    if not poll_ended_ok:
        return {"state": "degraded", "code": "harness.timeout", "message": f"index build not finished within {timeout_s}s", "detail": "timed out polling index operation"}
    status = run_lore(lore, ["index", "status"], store_root, 120)
    if status["ok"]:
        state = str(status["data"].get("state", "")).lower()
        if state in RUNNING_STATES or state == "missing":
            return {"state": "degraded", "code": f"index-state-{state or 'unknown'}", "message": "", "detail": "index still not ready after build"}
        return {"state": "ready", "detail": f"index built (status state: {state or 'n/a'})"}
    err = status.get("error") or {}
    return {"state": "degraded", "code": err.get("code", "unknown"), "message": err.get("message", ""), "detail": "index status failed after build"}


def run_queries(lore: str, mode: str, queries: list, store_root: str | None, fetch_k: int, limit: int | None, project_root: str | None = None) -> list:
    selected = queries if limit is None else queries[:limit]
    results = []
    for idx, q in enumerate(selected, 1):
        entry = {
            "id": q["id"],
            "kind": q["kind"],
            "expect": q["expect"],
            "resembles": q.get("resembles"),
            "text": q["text"],
            "hits": [],
            "hit_rank": None,
            "error": None,
        }
        attempts = 0
        while True:
            attempts += 1
            res = run_lore(lore, ["query", q["text"], "--mode", mode, "--top-k", str(fetch_k)], store_root, 180, project_root)
            if res["ok"] and isinstance(res["data"], dict) and "results" in res["data"]:
                hits = [r["practiceId"] for r in res["data"]["results"]]
                entry["hits"] = hits[:fetch_k]
                if q["expect"] in hits:
                    entry["hit_rank"] = hits.index(q["expect"]) + 1
                if mode == "semantic" and res["data"].get("coverage"):
                    entry["coverage"] = res["data"]["coverage"]
                break
            if res["ok"] and str((res["data"] or {}).get("state", "")) == "preparing" and attempts < 3:
                print(f"  [{idx}/{len(selected)}] {q['id']}: index preparing, waiting...")
                time.sleep(15)
                continue
            err = res.get("error") or {}
            entry["error"] = f"{err.get('code', 'unknown')}: {err.get('message', '')}"
            break
        marker = "hit" if entry["hit_rank"] else ("err" if entry["error"] else "miss")
        print(f"  [{idx}/{len(selected)}] {q['id']}: {marker}" + (f" rank={entry['hit_rank']}" if entry["hit_rank"] else ""))
        results.append(entry)
    return results


def _hit_rate(rows: list, top_k: int) -> float | None:
    """Count failed queries as misses for both metrics and gates."""
    if not rows:
        return None
    return sum(
        not r["error"] and r["hit_rank"] is not None and r["hit_rank"] <= top_k
        for r in rows
    ) / len(rows)


def compute_metrics(results: list, top_k: int) -> dict:
    # Keep errored queries in the metric denominator so a partial run cannot
    # report an inflated hit rate. A degraded mode is handled separately and
    # never reaches this function as an evaluated mode.
    positives = [r for r in results if r["kind"] == "positive"]
    neighbors = [r for r in results if r["kind"] == "neighbor"]
    errors = [r["id"] for r in results if r["error"]]

    def rate(rows, pred):
        return round(len([r for r in rows if pred(r)]) / len(rows), 4) if rows else None

    def rounded_hit_rate(rows, k):
        raw = _hit_rate(rows, k)
        return round(raw, 4) if raw is not None else None

    positive_top1 = rounded_hit_rate(positives, 1)
    positive_topk = rounded_hit_rate(positives, top_k)
    neighbor_top1 = rounded_hit_rate(neighbors, 1)
    neighbor_topk = rounded_hit_rate(neighbors, top_k)
    trap_top1 = rate(neighbors, lambda r: r["hits"] and r["hits"][0] == r["resembles"])

    confusion = defaultdict(lambda: defaultdict(int))
    confused_counts = defaultdict(int)
    for r in neighbors:
        actual = r["hits"][0] if r["hits"] else "(no result)"
        resembles = r["resembles"]
        confusion[resembles][actual] += 1
        if actual != r["expect"]:
            confused_counts[(resembles, actual)] += 1
    confused_pairs = [
        {"resembles": resembles, "actual_top1": actual, "count": count}
        for (resembles, actual), count in confused_counts.items()
    ]
    confused_pairs.sort(key=lambda p: -p["count"])

    per_practice = {}
    for r in positives:
        per_practice.setdefault(r["expect"], []).append(r["hit_rank"])
    practice_rows = {
        pid: {"hit_ranks": ranks, "top1": 1 in ranks, "topk": any(x is not None and x <= top_k for x in ranks)}
        for pid, ranks in per_practice.items()
    }
    return {
        "positive": {"n": len(positives), "top1_rate": positive_top1, f"top{top_k}_rate": positive_topk},
        "neighbor": {"n": len(neighbors), "expect_top1_rate": neighbor_top1, f"expect_top{top_k}_rate": neighbor_topk, "trap_top1_rate": trap_top1},
        "confusion_matrix": {k: dict(v) for k, v in confusion.items()},
        "worst_confused_pairs": confused_pairs[:10],
        "per_practice_positives": practice_rows,
        "errored_queries": errors,
    }




def render_report(run: dict) -> str:
    lines = []
    modes = run.get("modes") or {}
    lines.append(f"# Retrieval evaluation: {run['fixture_set']} vs {run['pack']['name']}@{run['pack']['version']}")
    lines.append("")
    lines.append(f"- Generated: {run['generated']}  |  lore {run.get('lore_version', '?')}  |  mode(s): {', '.join(run['requested_modes'])}  |  top-k threshold: {run['top_k']}")
    lines.append(
        f"- Store: {run.get('store_root') or 'user-level default'}  |  Queries: "
        f"{run['totals']['runnable']} runnable, {run['totals']['skipped']} skipped, "
        f"{run['totals'].get('retired', 0)} retired"
    )
    if run.get("source_kind") == "project":
        lines.append(f"- Source: project ({run.get('project_root') or '?'} / {run.get('pack_root') or '?'})")
        checks = run.get("candidate_checks") or {}
        if checks:
            lines.append(
                "- Candidate loading: validate=passed; "
                f"context={checks.get('context_state', '?')}/base={checks.get('context_base', '?')}; "
                f"lore get={checks.get('practice_get_verified', 0)}/{checks.get('practice_files', 0)} Practices"
            )
    elif run.get("source_kind") == "store":
        lines.append("- Source: store")
    if run.get("partial_run"):
        lines.append(f"- Partial run (--limit {run['limit']}): Top-3 gate NOT EVALUATED; these results cannot pass a formal gate.")
    if run.get("skipped"):
        lines.append(f"- Skipped (Practice not in this Pack version): {len(run['skipped'])}")
    migration_validation = run.get("migration_validation") or {}
    if migration_validation.get("failures"):
        lines.append(f"- Migration validation failures: {len(migration_validation['failures'])}")
    coverage = run.get("coverage") or {}
    if coverage.get("uncovered"):
        lines.append(f"- Coverage gap: {len(coverage['uncovered'])} installed Practice(s) have no positive queries: "
                     + ", ".join(f"`{short(p)}`" for p in coverage["uncovered"]))
    failures = run.get("gate_failures") or []
    if failures:
        lines.append("")
        lines.append("## Gate failures")
        lines.append("")
        for f in failures:
            lines.append(f"- **{f.get('gate', 'gate')}**: {f.get('message', '')}")
    for mode, section in modes.items():
        lines.append("")
        if section["state"] == "degraded":
            err = section.get("reason") or {}
            lines.append(f"## {mode}: DEGRADED — not evaluated on this machine")
            lines.append("")
            lines.append(f"Index preparation failed with `{err.get('code')}` ({err.get('message')}). "
                         f"No {mode} numbers below; run on a machine where the semantic index builds to collect them.")
            if section.get("gate") is None and any(s.get("gate") for s in modes.values()):
                lines.append("")
                lines.append(f"The hit-rate gate was not evaluable for {mode} on this machine.")
            continue
        m = section["metrics"]
        pos, nb = m["positive"], m["neighbor"]
        topk_key = f"top{run['top_k']}_rate"
        nb_topk_key = f"expect_top{run['top_k']}_rate"
        if section.get("gate"):
            g = section["gate"]
            lines.append(f"## {mode} — gate {'PASSED' if g['passed'] else 'FAILED'} "
                         f"(positive top-3 {fmt_rate(g['observed'])} vs {g.get('source', 'flag')} minimum {fmt_rate(g['min'])})")
        else:
            lines.append(f"## {mode}")
        lines.append("")
        lines.append(f"- Positive queries: top-1 {fmt_rate(pos['top1_rate'])} ({pos['n']} queries), "
                     f"top-{run['top_k']} {fmt_rate(pos.get(topk_key))}")
        lines.append(f"- Neighbor queries: expected selected top-1 {fmt_rate(nb['expect_top1_rate'])} "
                     f"({nb['n']} queries), in top-{run['top_k']} {fmt_rate(nb.get(nb_topk_key))}, "
                     f"trap top-1 (query selects the Practice it resembles) {fmt_rate(nb['trap_top1_rate'])}")
        if m["errored_queries"]:
            lines.append(f"- Query errors: {len(m['errored_queries'])} ({', '.join(m['errored_queries'][:5])}...)")
        missed = [
            r for r in section["results"]
            if r["kind"] == "positive" and not r["error"] and not (r["hit_rank"] is not None and r["hit_rank"] <= run["top_k"])
        ]
        if missed:
            lines.append("")
            lines.append(f"Positive queries that missed top-{run['top_k']} (rewrite-priority input):")
            lines.append("")
            lines.append("| query | actual top-3 |")
            lines.append("|---|---|")
            for r in missed:
                actual = ", ".join(short(h) for h in r["hits"][:3]) or "(no result)"
                lines.append(f"| `{r['id']}` | {actual} |")
        if m["worst_confused_pairs"]:
            lines.append("")
            lines.append("Most confused neighbor selections (queries worded near 'resembles' that selected 'actual top-1' instead of the expected neighbor):")
            lines.append("")
            lines.append("| resembles | actual top-1 selection | count |")
            lines.append("|---|---|---|")
            for p in m["worst_confused_pairs"][:8]:
                lines.append(f"| `{short(p['resembles'])}` | `{short(p['actual_top1'])}` | {p['count']} |")
        reg = section.get("regression")
        if reg:
            lines.append("")
            lines.append(f"Regression vs baseline: {reg['common_queries']} common queries, "
                         f"{len(reg['regressions'])} lost hits, {len(reg['improvements'])} gained hits.")
            if reg.get("migrations"):
                lines.append(f"- Explicit Query migrations: {len(reg['migrations'])}")
            if reg.get("migration_failures"):
                lines.append(f"- Migrated Query target misses: {len(reg['migration_failures'])}")
            if reg.get("expect_mismatches"):
                lines.append(f"- Unrecorded expected-Practice changes: {len(reg['expect_mismatches'])}")
    lines.append("")
    lines.append(f"> {REPORT_NOTE}")
    lines.append("")
    return "\n".join(lines)


def short(pid: str) -> str:
    return pid.replace("agentic-coding.", "")


def fmt_rate(r) -> str:
    return "n/a" if r is None else f"{r * 100:.1f}%"


def write_artifacts(run: dict, args) -> None:
    if args.out:
        os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
        with open(args.out, "w", encoding="utf-8", newline="\n") as fh:
            json.dump(run, fh, indent=1)
            fh.write("\n")
        print(f"artifact: {args.out}")
    if args.report:
        os.makedirs(os.path.dirname(os.path.abspath(args.report)), exist_ok=True)
        with open(args.report, "w", encoding="utf-8", newline="\n") as fh:
            fh.write(render_report(run))
        print(f"report: {args.report}")


def main() -> int:
    ap = argparse.ArgumentParser(description="Evaluate fixture queries against an installed Pack via the lore CLI.")
    ap.add_argument("--fixtures", default=os.path.join("fixtures", "agentic-coding", "queries.yaml"))
    ap.add_argument("--mode", choices=("keyword", "semantic", "both"), default="both")
    ap.add_argument("--top-k", type=int, default=3, help="hit threshold; ranking is fetched a little deeper")
    ap.add_argument("--store-root", default=None, help="isolated LocalStore directory forwarded to lore")
    install_group = ap.add_mutually_exclusive_group()
    install_group.add_argument("--ensure-install", default=None, metavar="PACK[@VERSION]", help="lore pack install first if needed")
    install_group.add_argument("--project-root", default=None, metavar="DIR", help="candidate mode: evaluate the Pack under DIR/.lorelum/packs/agentic-coding")
    ap.add_argument("--baseline", default=None, help="previous run JSON artifact for regression comparison")
    ap.add_argument("--fail-on-baseline-regression", action="store_true", help="exit 1 when any evaluated mode loses a previously hit query")
    ap.add_argument("--out", default=None, help="write the JSON run artifact here")
    ap.add_argument("--report", default=None, help="write a Markdown report here")
    ap.add_argument("--report-from", default=None, metavar="RUN.JSON", help="re-render --report from an existing run artifact without querying")
    ap.add_argument("--lore", default="lore")
    ap.add_argument("--limit", type=int, default=None, help="run only the first N queries (smoke runs)")
    ap.add_argument("--semantic-timeout", type=int, default=600, help="seconds to wait for semantic index readiness")
    ap.add_argument("--require-coverage", action="store_true", help="fail if any installed Practice has no positive queries")
    ap.add_argument("--require-frozen", action="store_true", help="fail if any active fixture Query is not status: frozen")
    ap.add_argument("--check-discipline", action="store_true", help="fail if any query shares a 4+-word run with an installed Practice's title/applies_when (quotation matches prove nothing)")
    ap.add_argument("--min-top3", type=float, default=None, metavar="RATE", help="gate: minimum positive top-3 hit rate (0-1) for each evaluated mode; defaults to the fixture's min_top3 when present. Exit 1 below it; degraded modes are reported as not evaluated")
    args = ap.parse_args()

    if args.fail_on_baseline_regression and not args.baseline:
        ap.error("--fail-on-baseline-regression requires --baseline")
    if args.limit is not None and args.limit <= 0:
        ap.error("--limit must be positive")
    if limit_conflicts_with_formal_gates(args):
        print("error: --limit is only valid for exploratory runs, not formal gates", file=sys.stderr)
        return 2

    if args.report_from:
        if not args.report:
            print("error: --report-from requires --report", file=sys.stderr)
            return 2
        with open(args.report_from, encoding="utf-8") as fh:
            prior = json.load(fh)
        os.makedirs(os.path.dirname(os.path.abspath(args.report)), exist_ok=True)
        with open(args.report, "w", encoding="utf-8", newline="\n") as fh:
            fh.write(render_report(prior))
        print(f"report: {args.report} (rendered from {args.report_from})")
        return 0

    lore = shutil.which(args.lore) or args.lore
    probe = run_lore(lore, ["--version"], None, 60)
    lore_version = (probe.get("data") or {}).get("toolVersion")
    if not probe["ok"]:
        print(f"error: cannot run lore CLI at '{args.lore}'", file=sys.stderr)
        return 1

    doc = load_fixtures(args.fixtures)
    print(f"fixtures: {doc['fixture_set']} — {len(doc['queries'])} queries (top_k hint {doc.get('top_k')})")

    requested = ["keyword", "semantic"] if args.mode == "both" else [args.mode]
    fetch_k = max(args.top_k + 2, 5)
    policy = resolve_run_policy(args, doc)
    formal = policy.formal
    min_top3, min_top3_source = policy.min_top3, policy.min_top3_source

    if args.store_root:
        os.makedirs(args.store_root, exist_ok=True)

    if args.ensure_install:
        ensure_installed(lore, args.ensure_install, args.store_root)

    pack_name = doc.get("target_pack", "agentic-coding").split("@", 1)[0]
    if args.project_root:
        pack = project_pack_details(lore, args.project_root, pack_name, args.store_root)
        source_kind = "project"
    else:
        pack = installed_pack_details(lore, pack_name, args.store_root)
        source_kind = "store"
    installed_ids = set(pack["practice_ids"])
    print(f"pack: {pack['name']}@{pack['version']} — {len(installed_ids)} practices ({source_kind})")

    active_queries = _active_queries(doc)
    retired_queries = [q for q in doc["queries"] if q.get("status", "frozen") == "retired"]
    runnable, skipped = partition_queries(active_queries, installed_ids)
    if skipped:
        print(f"skipping {len(skipped)} queries whose target Practice is not in this Pack version:")
        for s in skipped:
            print(f"  - {s['id']}: {s['reason']}")

    run = {
        "schema": SCHEMA,
        "note": REPORT_NOTE,
        "generated": _now(),
        "fixture_set": doc["fixture_set"],
        "fixtures_path": os.path.normpath(args.fixtures),
        "pack": {"name": pack["name"], "version": pack["version"], "practice_count": len(installed_ids)},
        "source_kind": source_kind,
        "candidate_checks": pack.get("candidate_checks") if source_kind == "project" else None,
        "project_root": os.path.normpath(args.project_root) if args.project_root else None,
        "pack_root": os.path.normpath(os.path.join(args.project_root, ".lorelum", "packs", pack_name)) if args.project_root else None,
        "lore_version": lore_version,
        "store_root": os.path.normpath(args.store_root) if args.store_root else None,
        "requested_modes": requested,
        "top_k": args.top_k,
        "fetch_k": fetch_k,
        "limit": args.limit,
        "partial_run": args.limit is not None,
        "totals": {"runnable": len(runnable), "skipped": len(skipped), "retired": len(retired_queries)},
        "skipped": skipped,
        "retired": [q["id"] for q in retired_queries],
        "coverage": None,
        "discipline": None,
        "min_top3": {"value": min_top3, "source": min_top3_source},
        "modes": {},
        "gate_failures": [],
    }

    pre_failures: list[GateFailure] = []
    if formal:
        unfrozen = [q["id"] for q in active_queries if q.get("status") != "frozen"]
        if unfrozen:
            pre_failures.append(GateFailure(
                "frozen-queries",
                f"{len(unfrozen)} active Query(s) are not frozen: {', '.join(unfrozen[:8])}",
            ))

    migration_failures = validate_migration_coverage(doc, installed_ids)
    run["migration_validation"] = {"checked": True, "failures": migration_failures}
    if formal and migration_failures:
        pre_failures.append(GateFailure(
            "migration-coverage",
            "; ".join(
                f"{failure.get('query', '(practice migration)')}: {failure['reason']}"
                for failure in migration_failures
            ),
        ))

    if formal and skipped:
        pre_failures.append(GateFailure(
            "missing-query-target",
            "; ".join(f"{item['id']}: {item['reason']}" for item in skipped),
        ))

    if not runnable:
        pre_failures.append(GateFailure("no-runnable-queries", "no runnable queries for this Pack"))

    queried = {
        q["expect"]
        for q in active_queries
        if q["kind"] == "positive" and not q.get("previous_expect")
    }
    uncovered = sorted(installed_ids - queried)
    run["coverage"] = {
        "practices_installed": len(installed_ids),
        "practices_with_positive_queries": len(queried & installed_ids),
        "uncovered": uncovered,
    }
    if uncovered and args.require_coverage:
        listed = ", ".join(short(p) for p in uncovered)
        pre_failures.append(GateFailure(
            "coverage",
            f"{len(uncovered)} installed practice(s) have no positive queries: {listed}",
        ))

    if args.check_discipline:
        violations = discipline_violations(active_queries, pack.get("practices", []))
        run["discipline"] = {"checked": True, "violations": len(violations)}
        if violations:
            detail = "; ".join(
                f"{v['query']} restates {short(v['practice'])} ({v['n']}-word run: \"{v['shared']}\")"
                for v in violations
            )
            pre_failures.append(GateFailure(
                "discipline",
                f"{len(violations)} query/practice restatement(s): {detail}",
            ))
        else:
            print("discipline: no query restates an installed Practice's title or applies_when text")

    if pre_failures:
        for failure in pre_failures:
            print(f"error: {failure.gate}: {failure.message}", file=sys.stderr)
            run["gate_failures"].append({"gate": failure.gate, "message": failure.message})
        write_artifacts(run, args)
        return 1

    print("discipline: no query restates an installed Practice's title or applies_when text") if args.check_discipline else None
    modes_section = {}
    for mode in requested:
        if mode == "semantic":
            ready = semantic_readiness(lore, args.store_root, args.semantic_timeout)
            if ready["state"] != "ready":
                print(f"SEMANTIC DEGRADED: {ready.get('code')} — {ready.get('message')} ({ready.get('detail')})")
                print("  semantic queries will NOT run on this machine; see the report for the annotation.")
                modes_section["semantic"] = {
                    "state": "degraded",
                    "reason": {"code": ready.get("code"), "message": ready.get("message")},
                    "detail": ready.get("detail"),
                    "metrics": None,
                    "results": [],
                }
                continue
            print(f"semantic index ready ({ready.get('detail')})")
        run_count = min(len(runnable), args.limit) if args.limit else len(runnable)
        print(f"running {run_count} queries in {mode} mode (fetch top {fetch_k})...")
        results = run_queries(lore, mode, runnable, args.store_root, fetch_k, args.limit, args.project_root)
        metrics = compute_metrics(results, args.top_k)
        pos, nb = metrics["positive"], metrics["neighbor"]
        print(f"{mode}: positive top-1 {fmt_rate(pos['top1_rate'])}, "
              f"top-{args.top_k} {fmt_rate(pos[f'top{args.top_k}_rate'])} | "
              f"neighbor expected top-1 {fmt_rate(nb['expect_top1_rate'])}, trap top-1 {fmt_rate(nb['trap_top1_rate'])}")
        section = {"state": "ok", "metrics": metrics, "results": results}
        if min_top3 is not None:
            pos_rows = [r for r in results if r["kind"] == "positive"]
            observed = _hit_rate(pos_rows, 3) or 0.0
            gate = {"metric": "positive_top3", "min": min_top3, "observed": round(observed, 4), "passed": observed >= min_top3, "source": min_top3_source}
            section["gate"] = gate
            print(f"gate [{mode}]: positive top-3 {fmt_rate(gate['observed'])} >= {fmt_rate(min_top3)} ({min_top3_source}) -> {'PASS' if gate['passed'] else 'FAIL'}")
        modes_section[mode] = section
    for mode, section in modes_section.items():
        if min_top3 is not None and section["state"] == "degraded":
            print(f"gate [{mode}]: NOT EVALUABLE (mode degraded on this machine); gate applies to evaluated modes only")

    run["modes"] = modes_section

    post_failures: list[GateFailure] = []
    if args.baseline:
        try:
            with open(args.baseline, encoding="utf-8") as fh:
                baseline = json.load(fh)
            compatibility_errors = baseline_compatibility_errors(
                baseline, pack_name, doc["fixture_set"], args.top_k, requested
            )
            if compatibility_errors:
                message = "; ".join(compatibility_errors)
                if args.fail_on_baseline_regression:
                    post_failures.append(GateFailure("baseline-schema", message))
                else:
                    print(f"warning: baseline comparison skipped: {message}", file=sys.stderr)
            else:
                for mode, section in modes_section.items():
                    if section.get("state") != "ok":
                        continue
                    base_mode = baseline["modes"][mode]
                    fixture_queries = {q["id"]: q for q in doc["queries"]}
                    section["regression"] = compare_baseline(
                        section["results"], base_mode["results"], args.top_k, fixture_queries
                    )
                    reg = section["regression"]
                    print(f"baseline [{mode}]: {reg['common_queries']} common, {len(reg['regressions'])} lost, {len(reg['improvements'])} gained")
                    if not args.fail_on_baseline_regression:
                        continue
                    for row in reg["regressions"]:
                        message = f"[{mode}] {row['id']} lost a hit (baseline rank {row['baseline_rank']}; now {row['now']})"
                        post_failures.append(GateFailure("baseline-regression", message))
                    for row in reg["migration_failures"]:
                        post_failures.append(GateFailure(
                            "migration-regression",
                            f"[{mode}] migrated Query {row['id']} does not hit new target {row['expect']}",
                        ))
                    for row in reg["expect_mismatches"]:
                        post_failures.append(GateFailure(
                            "baseline-query-mismatch",
                            f"[{mode}] {row['id']}: {row['reason']}",
                        ))
                    if reg["unaccounted_baseline_queries"]:
                        post_failures.append(GateFailure(
                            "baseline-query-removal",
                            f"[{mode}] baseline contains unaccounted Query(s): {', '.join(reg['unaccounted_baseline_queries'])}",
                        ))
        except (OSError, json.JSONDecodeError) as exc:
            if args.fail_on_baseline_regression:
                message = f"could not read baseline {args.baseline}: {exc}"
                post_failures.append(GateFailure("baseline-read", message))
            else:
                print(f"warning: could not read baseline {args.baseline}: {exc}", file=sys.stderr)

    if all(s["state"] == "degraded" for s in modes_section.values()):
        post_failures.append(GateFailure("all-degraded", "every requested mode degraded; no evaluation ran"))

    for mode, section in modes_section.items():
        gate = section.get("gate")
        if gate and not gate["passed"]:
            post_failures.append(GateFailure(
                "min-top3",
                f"[{mode}] positive top-3 {fmt_rate(gate['observed'])} below minimum {fmt_rate(gate['min'])}",
            ))
        if formal and section.get("state") == "ok":
            errors = [r["id"] for r in section.get("results", []) if r.get("error")]
            if errors:
                post_failures.append(GateFailure(
                    "query-errors",
                    f"[{mode}] {len(errors)} Query execution error(s): {', '.join(errors[:8])}",
                ))

    for failure in post_failures:
        print(f"error: {failure.gate}: {failure.message}", file=sys.stderr)
        run["gate_failures"].append({"gate": failure.gate, "message": failure.message})

    write_artifacts(run, args)
    return 1 if run["gate_failures"] else 0


if __name__ == "__main__":
    sys.exit(main())
